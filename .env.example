# Copy to .env.local; enter your key there, never in browser code.
# Leave empty for the complete deterministic demo. Restart server after changes.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Process-wide caps, reset when the local server restarts. Concurrency is 2.
AI_MAX_REQUESTS=60
AI_MAX_TOKENS=100000
AI_TIMEOUT_MS=12000
PORT=3001
