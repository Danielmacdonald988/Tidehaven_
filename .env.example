# Copy to .env.local; enter a key there, never in browser code or source control.
# Empty key means explicit deterministic demo; provider/budget errors mean fallback.
# Restart server after changing these settings.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Per server process. Restart resets counters; these are not account-wide billing caps.
AI_MAX_REQUESTS=60
AI_MAX_TOKENS=100000
AI_MAX_CONCURRENCY=2
AI_MAX_USD=1.00
AI_MAX_OUTPUT_TOKENS=400
# Total time across at most two HTTP attempts, not per-attempt time.
AI_TIMEOUT_MS=12000
# GPT-4.1 mini standard text prices per million tokens, verified 2026-10-21:
# https://developers.openai.com/api/docs/models/gpt-4.1-mini
# Both prices MUST be supplied when choosing another model.
# No cached-input discount is assumed. Failed/uncertain usage consumes reservation.
AI_INPUT_USD_PER_MILLION=0.40
AI_OUTPUT_USD_PER_MILLION=1.60
PORT=3001
